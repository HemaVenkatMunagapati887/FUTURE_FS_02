# Root .gitignore for the CRM monorepo

# Node dependencies
/node_modules/
/backend/node_modules/
/frontend/node_modules/

# Environment files
.env
.env.local
.env.*.local
/backend/.env
/frontend/.env

# Build output
/dist/
/frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store

# IDE/editor files
.vscode/
.idea/

# Misc
*.local
