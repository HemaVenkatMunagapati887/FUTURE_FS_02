PORT=5000
# Replace with your MongoDB Atlas connection string
# Example: mongodb+srv://<db_username>:<db_password>@cluster0.klpmixl.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.klpmixl.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
